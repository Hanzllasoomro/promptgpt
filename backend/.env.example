# Copy to .env for local development. Never commit a real .env.
# CORS_ORIGINS: comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional server-side fallbacks. Leave empty to require bring-your-own-key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HF_API_KEY=
LLM_TIMEOUT_S=60
